ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -fno-strict-overflow -Wsign-compare -DNDEBUG -g -O2 -Wall -g -fstack-protector-strong -Wformat -Werror=format-security -g -fwrapv -O2 -fPIC -I/usr/local/lib/python3.12/dist-packages/torch/include -I/usr/local/lib/python3.12/dist-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/usr/include/python3.12 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_C -std=c++17
cuda_cflags = -I/usr/local/lib/python3.12/dist-packages/torch/include -I/usr/local/lib/python3.12/dist-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/usr/include/python3.12 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -I/kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/third_party/glm/ -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_C -gencode=arch=compute_75,code=sm_75 -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-312/cuda_rasterizer/backward.o: cuda_compile /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/cuda_rasterizer/backward.cu
build /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-312/cuda_rasterizer/forward.o: cuda_compile /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/cuda_rasterizer/forward.cu
build /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-312/cuda_rasterizer/rasterizer_impl.o: cuda_compile /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/cuda_rasterizer/rasterizer_impl.cu
build /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-312/ext.o: compile /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/ext.cpp
build /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-312/rasterize_points.o: cuda_compile /kaggle/working/dropgaussian_paper_ablation/DropGaussian_release/submodules/diff-gaussian-rasterization/rasterize_points.cu








